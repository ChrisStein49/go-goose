// Cloudflare Workers (static assets) config. Netlify ignores this file.
// Build: `npm run build` -> dist/, served as static assets. `public/_headers` applies here too.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-goose",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
